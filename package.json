{
  "name": "changweihua.github.io",
  "type": "module",
  "version": "0.13.14",
  "description": "This is for study gulp project !",
  "author": "常伟华 (https://github.com/changweihua)",
  "license": "ISC",
  "homepage": "https://changweihua.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/changweihua.github.io"
  },
  "imports": {
    "#*": "./*"
  },
  "bin": {
    "npm-update-checker": "./scripts/cli.ts"
  },
  "scripts": {
    "docs:dev": "vitepress --mode development --host",
    "docs:prepare": "esno scripts/prepare.ts",
    "docs:build": "vitepress build",
    "build:debug": "node --inspect --max_old_space_size=4096 ./node_modules/vitepress/bin/vitepress.js build .",
    "docs:test": "vp test --ui",
    "docker:build": "docker build -t changweihua-github:latest . -f Dockerfile",
    "docs:preview": "vitepress preview --host",
    "docs:pdf": "npm run docs:build && node generate-pdf.js",
    "commit": "git add . && cz-customizable",
    "docs:vmark": "vmark",
    "docs:version": "esno ./utils/build-version.ts",
    "docs:vbuild": "vmark && vitepress build",
    "release": "npx release-it",
    "changelog": "conventional-changelog -p gitmoji-config -i CHANGELOG.md -s && git add CHANGELOG.md",
    "register:components": "vitepress-rc",
    "pkg:patch": "patch-package",
    "deploy:win": "powershell scripts/autoDeploy.bat",
    "image:build": "tsx scripts/optimize-images.ts",
    "image:convert": "tsx scripts/image-converter.ts",
    "font:prepare": "tsx scripts/font_extractor.ts",
    "font:build": "npx font-spider fonts-spider/index.html --no-backup && tsx scripts/font_move.ts",
    "font:test": "node --disable-warning=ExperimentalWarning --env-file .env scripts/env-test.ts",
    "prepare": "husky",
    "license:checker": "license-checker --trace-deprecation --json > ./licenses.json",
    "license:checker:csv": "license-checker --csv > ./licenses.csv",
    "test:unit": "vp test --ui",
    "test": "vp test",
    "mkcert:install": "mkcert -install",
    "mkcert:uninstall": "mkcert -uninstall",
    "export-pdf": "press-export-pdf export ./zh-CN/gallery",
    "ncu": "npx npm-check-updates",
    "nmi": "npx node-modules-inspector",
    "taze": "npx taze",
    "deploy": "node ./deploy/index.ts",
    "check": "esno scripts/check-npm-updates.ts",
    "check:simple": "esno scripts/simple-check.ts",
    "check:cli": "esno scripts/check-cli.ts",
    "optimize-icons": "svgfmt public/**/*.svg -o src/assets/icons",
    "optimize": "tsx scripts/optimize-images.ts",
    "optimize:clear": "tsx scripts/optimize-images.ts clear",
    "optimize:stats": "tsx scripts/optimize-images.ts stats",
    "optimize:test-jxl": "tsx scripts/optimize-images.ts test-jxl",
    "oxc:format": "oxfmt . --write",
    "oxc:format:check": "oxfmt . --check",
    "oxc:lint": "oxlint src",
    "oxc:lint:fix": "oxlint . --fix",
    "oxc:check": "npm run format:check && npm run lint"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
